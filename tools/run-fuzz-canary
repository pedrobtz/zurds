#!/bin/sh
# The fuzz gate's canary (roadmap Stage 10): builds the fuzz target with
# -DZRD_FUZZ_CANARY and the sanitizers, without libFuzzer, and checks that it
# runs every seed cleanly and then crashes on the planted input. A target
# that cannot crash would make a clean campaign mean nothing.
#
# Usage: tools/run-fuzz-canary [seed-dir]   (default: tests/testthat/fixtures)
set -eu
DIR="${1:-tests/testthat/fixtures}"
CC="${CC:-cc}"
ZUFAST=$(Rscript -e 'cat(system.file("include", package = "zufast"))')
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
FLAGS="-std=c99 -g -O1 -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all"
# shellcheck disable=SC2086
$CC $FLAGS -DZRD_STANDALONE -DZRD_FUZZ_CANARY -Isrc -I"$ZUFAST" \
  src/zrd_reader.c src/zrd_walk.c src/zrd_scan.c src/zrd_inflate.c tools/fuzz/harness.c tools/fuzz/driver.c \
  -o "$out/target"
"$out/target" "$DIR"/*
echo "==> the target runs every seed in $DIR cleanly"
printf 'ZRDCANRY' > "$out/canary"
if "$out/target" "$out/canary" 2>/dev/null; then
  echo "FAIL: the canary did not crash the target" >&2
  exit 1
fi
echo "==> canary crashed the target, as it must"
